rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId}/boats/{boatId} {
      function signedIn() {
        return request.auth != null;
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'uid', 'nickname', 'wish', 'imageData', 'frame', 'boatType',
          'stickers', 'photoAdjust', 'clientTime', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'nickname', 'wish', 'imageData', 'frame', 'boatType',
          'stickers', 'photoAdjust', 'clientTime', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 18
        && request.resource.data.wish is string
        && request.resource.data.wish.size() <= 160
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() <= 200000
        && (request.resource.data.imageData == ''
          || request.resource.data.imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$'))
        && request.resource.data.frame in ['heart', 'star', 'flower', 'y2k', 'circle', 'square']
        && request.resource.data.boatType in ['leaf', 'lotus', 'cyber']
        && request.resource.data.stickers is list
        && request.resource.data.stickers.size() <= 3
        && request.resource.data.photoAdjust is map
        && request.resource.data.photoAdjust.keys().hasOnly(['x', 'y', 'zoom', 'rotate', 'dots', 'grain', 'flash'])
        && request.resource.data.clientTime is string
        && request.resource.data.createdAt == request.time;

      // กระทงเป็นบันทึกถาวร: ป้องกันการแก้ไข/ลบจาก client ในตัวอย่างนี้
      allow update, delete: if false;
    }
  }
}
